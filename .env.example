# Manifest issuer (paths refer to mounted, non-versioned files)
MANIFEST_SIGNING_KEY_PATH=/run/secrets/manifest-signing.key
MANIFEST_ROOT_PUBLIC_KEY_PATH=/run/config/manifest-root.pub
MANIFEST_KEY_POLICY_PATH=/run/config/manifest-key-policy.json
MANIFEST_STATE_PATH=/var/lib/vchs/issuer-state.json
MANIFEST_CATALOG_PATH=/run/config/nodes.json

# Optional pilot access registration. Set both or neither.
# Loopback may use sslmode=disable; remote PostgreSQL must use verify-full and an approved CA.
DATABASE_URL=postgres://vchs:replace-me@127.0.0.1:5432/vchs?sslmode=disable
PILOT_ADMIN_TOKEN=replace-with-at-least-32-random-characters
