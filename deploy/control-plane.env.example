LISTEN_ADDRESS=127.0.0.1:8080
MANIFEST_CATALOG_PATH=/etc/acvpn/nodes.json
MANIFEST_SIGNING_KEY_PATH=/etc/acvpn/manifest-signing.key
MANIFEST_ROOT_PUBLIC_KEY_PATH=/etc/acvpn/manifest-root.pub
MANIFEST_KEY_POLICY_PATH=/etc/acvpn/manifest-key-policy.json
MANIFEST_STATE_PATH=/var/lib/acvpn/issuer-state.json
# For pilot metadata, uncomment BOTH after provisioning the dedicated DB login.
# Use the dashboard's direct or session-pooler URL with sslmode=verify-full.
# DATABASE_URL=
# PILOT_ADMIN_TOKEN=
